# PageKit 设备配置模板 —— 复制为 .env 后按需修改，`./build.sh load` 一键写入设备
#   cp .env.example .env && ./build.sh load
# .env 已在 .gitignore，代理地址与 token 不会入库

# ---- MCP token（重装/换机后恢复，客户端无需改配置；留空 = 保持设备当前值）----
PAGEKIT_TOKEN=

# ---- WebView 代理（仅 WebView 网络栈，不影响系统其他流量）----
PAGEKIT_PROXY_ENABLED=true
PAGEKIT_PROXY_HOST=172.16.14.199
PAGEKIT_PROXY_PORT=7890
# 分号分隔；留空表示全部走代理
PAGEKIT_PROXY_BYPASS=

# ---- 屏保（防烧屏）----
# 闲置多久进屏保（毫秒）：30000=30秒 60000=1分 120000=2分 300000=5分 0=关闭
PAGEKIT_SCREENSAVER_TIMEOUT_MS=120000

# ---- 并发 ----
# 每 Profile 最大并发 session 数（1-8，默认 4）
PAGEKIT_MAX_SESSIONS=4
